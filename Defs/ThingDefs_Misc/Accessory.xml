<?xml version="1.0" encoding="utf-8" ?>
<Defs> 
	<ThingDef Name="EarsAndTailBase" Abstract="True">
		<thingClass>Apparel</thingClass>
		<category>Item</category>
		<tickerType>Never</tickerType>
		<recipeMaker>
			  <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			  <workSkill>Crafting</workSkill>
			  <effectWorking>Tailor</effectWorking>
			  <soundWorking>Recipe_Tailor</soundWorking>
			  <skillRequirements>
				<Crafting>4</Crafting>
			  </skillRequirements>
			  <recipeUsers>
				<li>RBACraft</li>
			  </recipeUsers>
		</recipeMaker>
		<costStuffCount>30</costStuffCount>
        <stuffCategories>
          <li>Fabric</li>
          <li>Leathery</li>
        </stuffCategories>
		<thingCategories>
          <li>Apparel</li>
        </thingCategories>
		<statBases>
          <MaxHitPoints>100</MaxHitPoints>
          <WorkToMake>100</WorkToMake>
          <Mass>0.1</Mass>
          <StuffEffectMultiplierArmor>0.05</StuffEffectMultiplierArmor>
          <StuffEffectMultiplierInsulation_Cold>0.02</StuffEffectMultiplierInsulation_Cold>
          <StuffEffectMultiplierInsulation_Heat>0.01</StuffEffectMultiplierInsulation_Heat>
          <EquipDelay>1</EquipDelay>
        </statBases>
		<apparel>
          <bodyPartGroups>
            <li>UpperHead</li>
          </bodyPartGroups>
          <layers>
            <li>Overhead</li>
          </layers>
          <tags>
            <li></li>
          </tags>
          <defaultOutfitTags>
            <li>Worker</li>
            <li>Soldier</li>
          </defaultOutfitTags>
          <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
		  <countsAsClothingForNudity>true</countsAsClothingForNudity>
        </apparel>
		<colorGenerator Class="ColorGenerator_StandardApparel" />
		<comps>
			<li Class="CompProperties_Forbiddable" />
		</comps>
	</ThingDef>

