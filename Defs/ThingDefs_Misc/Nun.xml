		</modExtensions>
		
	</ThingDef>
	
<!-- CHILD DEF -->
	
	<ThingDef ParentName="ApparelNeckMBase">
        <defName>NunNA</defName>
        <label>Nun - Neckwear A</label>
        <description>Part of the Nun Series. A religious neck garment for combination with other clothing. By itself, the drapes barely act as cover for the chest but can be worn bare. Wearing this outfit gives the wearer an ambience of faith and trustworthiness, allowing her to convert others much easier.</description>
        <graphicData>
          <texPath>Things/Apparel/Nun/NunNA</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
		<equippedStatOffsets>
			<NegotiationAbility>0.05</NegotiationAbility>
			<ConversionPower MayRequire="Ludeon.RimWorld.Ideology">0.1</ConversionPower>
		</equippedStatOffsets>
        <apparel>
          <wornGraphicPath>Things/Apparel/Nun/NunNA</wornGraphicPath>
		  <useWornGraphicMask>true</useWornGraphicMask>
        </apparel>
    </ThingDef>

	<ThingDef ParentName="ApparelNeckMBase">
        <defName>NunNB</defName>
        <label>Nun - Neckwear B</label>
        <description>Part of the Nun Series. A religious neck garment for combination with other clothing. This version wraps only around the neck, leaving the upper chest open which is why it is often combined with a full outfit. Wearing this outfit gives the wearer an ambience of faith and holiness, allowing her to suppress different kinds of evil.</description>
        <graphicData>
          <texPath>Things/Apparel/Nun/NunNB</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
		<equippedStatOffsets>
			<NegotiationAbility>0.05</NegotiationAbility>
			<ActivitySuppressionRate MayRequire="Ludeon.RimWorld.Anomaly">0.1</ActivitySuppressionRate>
		</equippedStatOffsets>
        <apparel>
          <wornGraphicPath>Things/Apparel/Nun/NunNB</wornGraphicPath>
		  <useWornGraphicMask>true</useWornGraphicMask>
        </apparel>
    </ThingDef>

	<ThingDef ParentName="ApparelTorsoMBase">
        <defName>NunA</defName>
        <label>Nun - Torso A</label>
        <description>Part of the Nun Series. A piece of religious garment that covers the torso but not the breast. It is meant to be supplemented by drapes. Wearing this outfit gives the wearer an ambience of faith and trustworthiness, allowing her to convert others much easier.</description>
