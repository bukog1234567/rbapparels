<?xml version="1.0" encoding="utf-8" ?>
<Defs> 
	<ThingDef Name="ApparelNeckMBase" Abstract="True">
		<thingClass>Apparel</thingClass>
		<category>Item</category>
		<tickerType>Never</tickerType>
		<recipeMaker>
			  <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			  <workSkill>Crafting</workSkill>
			  <effectWorking>Tailor</effectWorking>
			  <soundWorking>Recipe_Tailor</soundWorking>
			  <skillRequirements>
				<Crafting>5</Crafting>
			  </skillRequirements>
			  <recipeUsers>
				<li>RBACraft</li>
			  </recipeUsers>
		</recipeMaker>
		<costStuffCount>50</costStuffCount>
        <stuffCategories>
          <li>Fabric</li>
        </stuffCategories>
        <thingCategories>
          <li>Apparel</li>
        </thingCategories>
        <statBases>
          <MaxHitPoints>100</MaxHitPoints>
          <WorkToMake>800</WorkToMake>
          <Mass>0.2</Mass>
          <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
          <StuffEffectMultiplierInsulation_Cold>0.1</StuffEffectMultiplierInsulation_Cold>
          <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
          <EquipDelay>1</EquipDelay>
        </statBases>
		<apparel>
          <bodyPartGroups>
            <li>Neck</li>
          </bodyPartGroups>
          <layers>
            <li>Middle</li>
          </layers>
          <tags>
            <li></li>
          </tags>
          <defaultOutfitTags>
            <li>Worker</li>
            <li>Soldier</li>
          </defaultOutfitTags>
          <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
		  <countsAsClothingForNudity>true</countsAsClothingForNudity>
        </apparel>
		<colorGenerator Class="ColorGenerator_StandardApparel" />
		
		<comps>
			<li Class="CompProperties_Forbiddable" />
		</comps>
		<modExtensions>
			<li Class="BodyTypeApparelRestrictions.ApparelBodyTypeExtension">
			<allowedBodyTypes>
				<li>Female</li>
				<li>Thin</li>
			</allowedBodyTypes>
			</li>
		</modExtensions>
	</ThingDef>
	
