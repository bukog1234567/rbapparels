	<ThingDef ParentName="ApparelTorsoMBase">
        <defName>NunC</defName>
        <label>Nun - Torso C</label>
        <description>Part of the Nun Series. A piece of garment that barely leaves anything to the imagination. It also works great with drapes. Wearing this outfit gives the wearer an ambience of faith and seduction, allowing her to convert others much more often.</description>
        <graphicData>
          <texPath>Things/Apparel/Nun/NunC</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
		<equippedStatOffsets>
