        </apparel>
    </ThingDef>

    <ThingDef>
        <thingClass>Apparel</thingClass>
		<category>Item</category>
		<tickerType>Never</tickerType>
		<defName>NunH</defName>
        <label>Nun - Headwear</label>
        <description>Part of the Nun Series. A small headwear that covers the hair and is used for religious ceremonies or daily life. It is particularly suited for worship, prayers, and meditation.</description>
        <recipeMaker>
          <researchPrerequisite>ComplexClothing</researchPrerequisite>
        </recipeMaker>
        <graphicData>
          <texPath>Things/Apparel/Nun/NunH</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
		<equippedStatOffsets>
			<NegotiationAbility>0.05</NegotiationAbility>
			<PsychicSensitivity>100</PsychicSensitivity>
		</equippedStatOffsets>
        <costStuffCount>50</costStuffCount>
        <stuffCategories>
