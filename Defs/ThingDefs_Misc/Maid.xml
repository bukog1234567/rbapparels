        <graphicData>
          <texPath>Things/Apparel/Maid/MNeck</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
		<equippedStatOffsets>
			<CleaningSpeed>0.1</CleaningSpeed>
			<RestFallRateFactor>0.1</RestFallRateFactor>
		</equippedStatOffsets>
        <apparel>
          <wornGraphicPath>Things/Apparel/Maid/MNeck</wornGraphicPath>
		  <useWornGraphicMask>true</useWornGraphicMask>
        </apparel>
    </ThingDef>

