<?xml version="1.0" encoding="utf-8" ?>
<Defs> 

    <ThingDef ParentName="BikiniTorsoOSBase">
        <defName>MBik</defName>
        <label>Maid - Maid Bikini</label>
        <description>Part of the Maid Series. This is a bikini created to look like maidwear... or is it a maid clothing designed to be a bikini? Its wearer feels a boost when doing all kinds of housework.</description>
        <graphicData>
          <texPath>Things/Apparel/Maid/MBik</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
		<equippedStatOffsets>
			<CleaningSpeed>0.2</CleaningSpeed>
			<GeneralLaborSpeed>0.1</GeneralLaborSpeed>
		</equippedStatOffsets>
        <apparel>
          <wornGraphicPath>Things/Apparel/Maid/MBik</wornGraphicPath>
		  <useWornGraphicMask>true</useWornGraphicMask>
        </apparel>
    </ThingDef>

	<ThingDef ParentName="ApparelNeckMBase">
        <defName>MNeck</defName>
