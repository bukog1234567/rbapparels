    <ThingDef ParentName="BikiniTorsoOSBase">
        <defName>FrBik</defName>
        <label>Bikini - Frilled</label>
        <description>A set of swimwear with frills that adds a dash of cuteness. A little more bouyant than the other types of swimwear, it is suited for the beach and water-related activities. Don't be afraid to get wet.</description>
        <graphicData>
          <texPath>Things/Apparel/Bikini/FrBik</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
		<equippedStatOffsets>
			<PawnBeauty>1</PawnBeauty>
			<FishingSpeed MayRequire="Ludeon.RimWorld.Odyssey">0.05</FishingSpeed>
			<FishingYield MayRequire="Ludeon.RimWorld.Odyssey">0.05</FishingYield>
		</equippedStatOffsets>
        <apparel>
          <wornGraphicPath>Things/Apparel/Bikini/FrBik</wornGraphicPath>
		  <useWornGraphicMask>false</useWornGraphicMask>
        </apparel>
    </ThingDef>

    <ThingDef ParentName="BikiniTorsoOSBase">
        <defName>ShBik</defName>
        <label>Bikini - Shiny</label>
        <description>A set of shiny bikini that can be combined with other types of clothing or used on its own. It is light and allow huge range of motion, making it useful for all types of activities.</description>
        <graphicData>
          <texPath>Things/Apparel/Bikini/ShBik</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
		<equippedStatOffsets>
			<PawnBeauty>1</PawnBeauty>
			<MoveSpeed>0.1</MoveSpeed>
		</equippedStatOffsets>
        <apparel>
          <wornGraphicPath>Things/Apparel/Bikini/ShBik</wornGraphicPath>
		  <useWornGraphicMask>false</useWornGraphicMask>
        </apparel>
    </ThingDef>

</Defs>